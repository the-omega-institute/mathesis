{
  "schema": "omega.display-monitor.v1",
  "repository": "the-omega-institute/mathesis",
  "checks": [
    {
      "id": "home",
      "url": "https://mathesis-omega-research.apps.chrono-ai.fun/",
      "owner": "the-omega-institute/mathesis",
      "kind": "html",
      "contains": "Mathesis"
    },
    {
      "id": "papers",
      "url": "https://mathesis-omega-research.apps.chrono-ai.fun/api/v1/collected-papers?limit=1",
      "owner": "the-omega-institute/mathesis",
      "kind": "json",
      "required": [
        "items"
      ],
      "nonempty": "items"
    },
    {
      "id": "material-index",
      "url": "https://papers.trureturing.org/materials-index.json",
      "owner": "the-omega-institute/trureturing-outreach-engine",
      "kind": "materials",
      "equals": {
        "schema": "mathesis.materials-index.v1"
      },
      "required": [
        "entries",
        "generated_at"
      ],
      "nonempty": "entries"
    }
  ],
  "browser": [
    {
      "id": "reader",
      "url": "https://mathesis-omega-research.apps.chrono-ai.fun/",
      "owner": "the-omega-institute/mathesis"
    }
  ],
  "targets": {
    "the-omega-institute/mathesis": {
      "branch": "develop",
      "paths": [
        "web/src/pages/",
        "web/src/components/",
        "web/src/styles.css",
        "web/src/lib/"
      ],
      "verify": [
        [
          "npm",
          "ci",
          "--ignore-scripts",
          "--prefix",
          "web"
        ],
        [
          "npm",
          "run",
          "typecheck",
          "--prefix",
          "web"
        ],
        [
          "npm",
          "test",
          "--prefix",
          "web"
        ]
      ],
      "auto_merge": true,
      "github_service": "display-mathesis-github"
    },
    "the-omega-institute/trureturing-outreach-engine": {
      "branch": "main",
      "paths": [
        "managed/mathesis_delivery.py",
        "scripts/short_notes/service.py",
        "scripts/short_notes/workflow.py"
      ],
      "verify": [
        [
          "python3",
          "-m",
          "compileall",
          "-q",
          "managed",
          "scripts/short_notes"
        ],
        [
          "python3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "managed/tests"
        ],
        [
          "python3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "scripts/short_notes",
          "-p",
          "test_*.py"
        ]
      ],
      "auto_merge": false,
      "github_service": "display-outreach-github"
    }
  },
  "publisher_login": "AlyciaBHZ"
}
